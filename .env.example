# ============================================================
# 小控 环境配置模板
#
# 复制为 .env 后填写。.env 只能留在本机，绝对不能提交 Git。
#
# 优先级（从高到低）：
#   1. 真实环境变量 / .env
#   2. %APPDATA%\小控\settings.json（界面里保存的值）
#   3. src/xiaokong/embedded_secrets.py（本地内置密钥，不提交）
#   4. 代码默认值
# ============================================================

# ---------- 大模型（OpenAI 兼容） ----------
XIAOKONG_LLM_BASE_URL=https://opencode.ai/zen/go/v1
XIAOKONG_LLM_API_KEY=
XIAOKONG_CHAT_MODEL=deepseek-v4.1-flash

# ---------- 智能体 ----------
# chat = 直接流式对话（默认）；deep = deepagents 0.7.28
XIAOKONG_AGENT_KIND=chat

# ---------- 课程助手提示词（可选，留空用默认） ----------
# XIAOKONG_SYSTEM_PROMPT=

# ---------- 语音识别 ASR ----------
XIAOKONG_ASR_PROVIDER=doubao
XIAOKONG_ASR_BASE_URL=https://api.groq.com/openai/v1
XIAOKONG_ASR_API_KEY=
XIAOKONG_ASR_MODEL=whisper-large-v3-turbo

# ---------- 语音合成 TTS ----------
XIAOKONG_TTS_PROVIDER=doubao
XIAOKONG_TTS_BASE_URL=https://api.tts.ai
XIAOKONG_TTS_API_KEY=
XIAOKONG_TTS_MODEL=kokoro
XIAOKONG_TTS_VOICE=zf_xiaoxiao

# ---------- 豆包语音 ----------
XIAOKONG_DOUBAO_API_KEY=
XIAOKONG_DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
XIAOKONG_DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts
XIAOKONG_DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
XIAOKONG_DOUBAO_ASR_MODEL=bigmodel

# ---------- 界面开关 ----------
XIAOKONG_AUTO_SEND_VOICE=true
XIAOKONG_AUTO_SPEAK_REPLIES=true
